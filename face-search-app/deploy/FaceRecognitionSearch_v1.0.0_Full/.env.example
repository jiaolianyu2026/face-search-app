# 人脸识别搜索应用 - 环境变量配置示例
# 复制此文件为 .env 并根据需要修改配置

# ========================================
# 后端配置
# ========================================

# Flask 配置
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# 文件上传配置
MAX_FILE_SIZE_MB=10
UPLOAD_FOLDER=backend/temp_uploads

# 人脸识别配置
SIMILARITY_THRESHOLD=0.6
FACE_FEATURE_DIM=128
DETECTION_TIMEOUT=2

# 缓存配置
CACHE_ENABLED=True
CACHE_DIR=backend/cache
CACHE_DB_NAME=face_cache.db

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=backend/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ========================================
# 前端配置
# ========================================

# Vite 配置
VITE_PORT=3000
VITE_HOST=localhost

# API 配置
VITE_API_BASE_URL=http://localhost:5000

# ========================================
# 性能配置
# ========================================

# 批处理大小
BATCH_SIZE=100

# 线程池大小
THREAD_POOL_SIZE=4

# 超时设置（秒）
REQUEST_TIMEOUT=30
SEARCH_TIMEOUT=300

# ========================================
# 安全配置
# ========================================

# CORS 配置
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 允许的文件格式
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# ========================================
# 开发配置（仅开发环境使用）
# ========================================

# 开发模式
DEV_MODE=False

# 热重载
HOT_RELOAD=False

# 调试日志
DEBUG_LOGGING=False
